                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "FILE",
                  "type": "file",
                  "description": "(Required) The file to be imported."
                }
              ]
            }
          },
          "response": [
